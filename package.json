{
  "name": "wedding-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun run db:migrate && bun run db:seed && next start",
    "lint": "eslint",
