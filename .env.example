DATABASE_URL="postgresql://user:password@host:5432/database"
# Shared admin password, and a long random string used to sign the admin cookie.
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-with-openssl-rand-hex-32"
# Optional: RSVP notification emails via Resend. Leave blank to skip emails.
RESEND_API_KEY=""
EMAIL_FROM="Wedding RSVPs <rsvp@yourdomain.com>"
# Public site URL, used for the QR code.
NEXT_PUBLIC_SITE_URL="https://example.com"
# Optional: S3-compatible bucket for photos (a Railway bucket works). Without
# these, photos are saved to ./.uploads, which is fine locally but not on Railway.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
